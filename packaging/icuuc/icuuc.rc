// Version resource of the ICU forwarder; its version is its own, so that the file stays the same
// bytes from one release to the next.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Random New World project"
            VALUE "FileDescription", "Forwards the ICU functions Qt needs to icu.dll"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "icuuc"
            VALUE "LegalCopyright", "Mozilla Public License 2.0"
            VALUE "OriginalFilename", "icuuc.dll"
            VALUE "ProductName", "Random New World"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
